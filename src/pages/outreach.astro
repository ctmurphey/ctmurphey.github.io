---
import Layout from "@/layouts/Layout.astro";
import { profile } from "@/settings";
import BetterIcon from "@/components/ui/BetterIcon.astro";
import List from "@/components/ui/List.astro";
import {RESEARCH_ICONS} from "@/data/researchIcons";

// const { research_areas } = profile;
---

<Layout title="Outreach | Tanner Murphey">
  <div class="prose max-w-none">
    <h1 class="text-3xl font-bold mb-8">Outreach</h1>

    <div class="mb-12">
      <p class="text-lg mb-6">
        My research involves searching for new exploding stars (supernovae) with the Dark Energy Camera in Chile. The earlier we can catch these new transients, the earlier we can get follow-up data using other instruments like spectrometers to probe the conditions immediately after the explosion.
      </p>
      <p class="text-lg mb-6">
        These supernovae can tell us many things about our universe, from how fast it's expanding to how many of the elements critical for life (like iron, oxygen, sulfer, and phosphorus) are produced in the abundances that we see in the universe today. 
      </p>
    </div>

    <h2 class="text-2xl font-bold mb-6">Research Areas</h2>
    <div class="grid gap-8 mb-12">
      {
        research_areas.map((area) => (
          <div class="flex gap-6 items-start">
            <BetterIcon>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke-width="2"
                class="size-6 stroke-accent"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d={RESEARCH_ICONS[area.field as keyof typeof RESEARCH_ICONS]?.path || RESEARCH_ICONS['computer-science'].path}
                />
              </svg>
            </BetterIcon>
            <div>
              <h3 class="text-xl font-semibold mb-2">{area.title}</h3>
              <p class="text-base">{area.description}</p>
            </div>
          </div>
        ))
      }
    </div>

    <List listTitle="Current Projects" listItems={[
      {
        title: "Interesting Transients",
        description: "DECam sees many transients when it observes. Some of these are rare or peculiar and push the limits of our knowledge about the universe around us."
      },
      {
        title: "Preparing for Rubin",
        description: "When the Vera Rubin Observatory turns on, it will usher a new wave of transient discovery. Few telescopes have both the field of view and viewing depth that DECam has, allowing us to better calibrate Rubin as it goes through its commissioning phase."
      },
      {
        title: "Supernova Cosmology",
        description: "With the recent publications involving the potential of evolving Dark Energy, we need more supernova data to test that theory's validity"
      },
    ]} />

    <h2 class="text-2xl font-bold mb-6">Research Impact</h2>
    <p class="text-lg mb-6">
      My research probes many different aspects of how our universe got to be the way it is. This work provides a unique opportunity to do deep studies of large populations of the largest producers of heavy elements in the universe.
    </p>
  </div>
</Layout>
