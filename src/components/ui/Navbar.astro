---
import { Image } from 'astro:assets';
import { profile } from '../../settings';
import SocialIcons from './SocialIcons.astro';
import ProfilePictures from '@/assets/astrofest_profile.jpeg';
import { getCollection } from 'astro:content';
import { template } from '@/settings';

const isBlogPopulated = await getCollection('blog').then(collection => collection.length > 0);
const { fullName } = profile;
---

<aside class="px-4 pt-4 h-screen w-[20rem] bg-base-200 text-base-content flex flex-col">
  <div class="flex flex-col gap-y-4 h-full">
    <div>
      <div class="flex justify-center items-center flex-col">
        <Image
          class="mask mask-circle object-cover size-44"
          src={ProfilePictures}
          alt={`Profile picture of ${fullName}`}
        />
        <h1 class="text-lg font-black mt-4 hidden lg:block">{fullName}</h1>
      </div>
      <div class="mx-4 mt-4">
        <ul class="space-y-2.5 menu grow shrink menu-md overflow-y-auto">
          <li>
            <a href={`${template.website_url}/`} class="text-lg">Home</a>
          </li>
          <li>
            <a href={`${template.website_url}/research`} class="text-lg">Research</a>
          </li>
          <li>
            <a href={`${template.website_url}/papers`} class="text-lg">Papers</a>
          </li>
          <li>
            <a href={`${template.website_url}/cv`} class="text-lg">CV</a>
          </li>
          {isBlogPopulated && (
            <li>
              <a href={`${template.website_url}/blog/1`} class="text-lg">Blog</a>
            </li>
          )}
          <li>
            <a href={`${template.website_url}/outreach`} class="text-lg">Outreach</a>
          </li>
          <li>
            <a href={`${template.website_url}/side-projects`} class="text-lg">Side Projects</a>
          </li>
        </ul>
      </div>
    </div>
    <div class="mx-4">
      <SocialIcons />
    </div>
  </div>
</aside>
