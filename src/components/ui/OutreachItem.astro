---
import { Image } from 'astro:assets';

export interface Props {
  title: string;
  description: string;
  imageSrc?: ImageMetadata;
  alt?: string;
}

const { title, description, imageSrc, alt = "" } = Astro.props;
---

<div class="bg-base-200 rounded-xl p-6 mb-8 shadow-md">
  <div class="flex flex-col gap-4">
    <div>
      <h2 class="text-2xl font-semibold mb-2">{title}</h2>
      <p class="text-base whitespace-normal">{description}</p>
    </div>
    {imageSrc && (
      <div class="w-full">
        <Image
          src={imageSrc}
          alt={alt}
          class="rounded-lg object-contain max-h-60 w-full mx-auto"
        />
      </div>
    )}
  </div>
</div>
