---
import { Image } from 'astro:assets';

export interface Props {
  title: string;
  github?: string;
  imageSrc?: ImageMetadata;
  alt?: string;
}

const { title, github, imageSrc, alt = "" } = Astro.props;
---

<div class="py-6">
  <h2 class="text-2xl font-semibold">{title}</h2>
  {github && <p class="text-sm text-accent italic mb-2">{github}</p>}
  <div class="text-base mb-2 space-y-2">
    <slot />
  </div>
  {imageSrc && (
    <Image
      src={imageSrc}
      alt={alt}
      class="rounded-lg mt-4 max-w-full object-contain"
    />
  )}
</div>
